<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Flight Search Form</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            min-height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
            padding: 20px;
        }

        .search-container {
            background: #1e3a5f;
            border-radius: 16px;
            padding: 8px;
            box-shadow: 0 20px 60px rgba(0, 0, 0, 0.3);
            width: 100%;
            max-width: 1200px;
            animation: slideUp 0.5s ease-out;
        }

        @keyframes slideUp {
            from {
                opacity: 0;
                transform: translateY(30px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .trip-type-container {
            margin-bottom: 8px;
        }

        .trip-type-select {
            background: rgba(255, 255, 255, 0.1);
            border: 1px solid rgba(255, 255, 255, 0.2);
            color: white;
            padding: 10px 16px;
            border-radius: 8px;
            font-size: 14px;
            cursor: pointer;
            transition: all 0.3s ease;
            min-width: 140px;
        }

        .trip-type-select:hover {
            background: rgba(255, 255, 255, 0.15);
            transform: translateY(-1px);
        }

        .trip-type-select:focus {
            outline: none;
            border-color: #4a9eff;
            box-shadow: 0 0 0 3px rgba(74, 158, 255, 0.2);
        }

        .search-form {
            display: flex;
            gap: 8px;
            align-items: center;
            flex-wrap: wrap;
        }

        .input-group {
            background: white;
            border-radius: 12px;
            padding: 16px 20px;
            flex: 1;
            min-width: 200px;
            position: relative;
            transition: all 0.3s ease;
        }

        .input-group:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 20px rgba(0, 0, 0, 0.15);
        }

        .input-group.focused {
            box-shadow: 0 0 0 3px rgba(74, 158, 255, 0.3);
        }

        .input-label {
            font-size: 12px;
            color: #6b7280;
            margin-bottom: 4px;
            font-weight: 500;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        .input-field {
            border: none;
            outline: none;
            font-size: 16px;
            color: #1f2937;
            width: 100%;
            font-weight: 500;
            background: transparent;
        }

        .input-field::placeholder {
            color: #9ca3af;
        }

        .swap-button {
            background: white;
            border: 2px solid #e5e7eb;
            border-radius: 50%;
            width: 44px;
            height: 44px;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            transition: all 0.3s ease;
            flex-shrink: 0;
            position: relative;
            z-index: 1;
            margin: 0 -20px;
        }

        .swap-button:hover {
            background: #f3f4f6;
            transform: rotate(180deg);
            border-color: #4a9eff;
        }

        .swap-icon {
            width: 20px;
            height: 20px;
        }

        .date-input {
            cursor: pointer;
        }

        .search-button {
            background: linear-gradient(135deg, #4a9eff 0%, #0066ff 100%);
            color: white;
            border: none;
            padding: 20px 40px;
            border-radius: 12px;
            font-size: 16px;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.3s ease;
            text-transform: uppercase;
            letter-spacing: 1px;
            box-shadow: 0 4px 15px rgba(74, 158, 255, 0.3);
        }

        .search-button:hover {
            transform: translateY(-2px);
            box-shadow: 0 6px 25px rgba(74, 158, 255, 0.4);
            background: linear-gradient(135deg, #5fa9ff 0%, #1976ff 100%);
        }

        .search-button:active {
            transform: translateY(0);
        }

        .passengers-dropdown {
            position: relative;
        }

        .passengers-summary {
            cursor: pointer;
            user-select: none;
        }

        .passengers-panel {
            position: absolute;
            top: calc(100% + 8px);
            left: 0;
            background: white;
            border-radius: 12px;
            box-shadow: 0 10px 40px rgba(0, 0, 0, 0.15);
            padding: 20px;
            min-width: 280px;
            display: none;
            z-index: 1000;
        }

        .passengers-panel.active {
            display: block;
            animation: fadeIn 0.3s ease;
        }

        @keyframes fadeIn {
            from {
                opacity: 0;
                transform: translateY(-10px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .passenger-type {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 16px;
        }

        .passenger-type:last-child {
            margin-bottom: 0;
        }

        .passenger-label {
            font-size: 14px;
            color: #374151;
            font-weight: 500;
        }

        .passenger-counter {
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .counter-btn {
            width: 32px;
            height: 32px;
            border-radius: 50%;
            border: 2px solid #e5e7eb;
            background: white;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: all 0.2s ease;
            font-size: 18px;
            color: #374151;
        }

        .counter-btn:hover:not(:disabled) {
            background: #4a9eff;
            color: white;
            border-color: #4a9eff;
            transform: scale(1.1);
        }

        .counter-btn:disabled {
            opacity: 0.3;
            cursor: not-allowed;
        }

        .counter-value {
            min-width: 30px;
            text-align: center;
            font-weight: 600;
            font-size: 16px;
        }

        .class-select {
            margin-top: 16px;
            padding-top: 16px;
            border-top: 1px solid #e5e7eb;
        }

        .class-select select {
            width: 100%;
            padding: 8px 12px;
            border: 1px solid #e5e7eb;
            border-radius: 8px;
            font-size: 14px;
            cursor: pointer;
            transition: all 0.3s ease;
        }

        .class-select select:hover {
            border-color: #4a9eff;
        }

        .class-select select:focus {
            outline: none;
            border-color: #4a9eff;
            box-shadow: 0 0 0 3px rgba(74, 158, 255, 0.1);
        }

        @media (max-width: 768px) {
            .search-form {
                flex-direction: column;
            }

            .swap-button {
                margin: -10px 0;
                transform: rotate(90deg);
            }

            .swap-button:hover {
                transform: rotate(270deg);
            }

            .input-group {
                width: 100%;
            }

            .search-button {
                width: 100%;
            }
        }
    </style>
</head>
<body>
    <div class="search-container">
        <div class="trip-type-container">
            <select class="trip-type-select" id="tripType">
                <option value="one-way">One way</option>
                <option value="round-trip">Round trip</option>
                <option value="multi-city">Multi-city</option>
            </select>
        </div>
        
        <div class="search-form">
            <div class="input-group">
                <div class="input-label">From</div>
                <input type="text" class="input-field" id="fromInput" placeholder="City or Airport" value="Nairobi Wilson (WIL)">
            </div>
            
            <button class="swap-button" onclick="swapLocations()">
                <svg class="swap-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M7 16l-4-4m0 0l4-4m-4 4h18M17 8l4 4m0 0l-4 4m4-4H3"/>
                </svg>
            </button>
            
            <div class="input-group">
                <div class="input-label">To</div>
                <input type="text" class="input-field" id="toInput" placeholder="City or Airport" value="Lodwar (LOK)">
            </div>
            
            <div class="input-group">
                <div class="input-label">Depart</div>
                <input type="date" class="input-field date-input" id="departDate" value="2025-08-16">
            </div>
            
            <div class="input-group" id="returnDateGroup" style="display: none;">
                <div class="input-label">Return</div>
                <input type="date" class="input-field date-input" id="returnDate">
            </div>
            
            <div class="input-group passengers-dropdown">
                <div class="input-label">Travellers and cabin class</div>
                <div class="input-field passengers-summary" onclick="togglePassengers()">
                    <span id="passengersSummary">1 Adult, Economy</span>
                </div>
                
                <div class="passengers-panel" id="passengersPanel">
                    <div class="passenger-type">
                        <span class="passenger-label">Adults</span>
                        <div class="passenger-counter">
                            <button class="counter-btn" onclick="updatePassengers('adults', -1)">−</button>
                            <span class="counter-value" id="adultsCount">1</span>
                            <button class="counter-btn" onclick="updatePassengers('adults', 1)">+</button>
                        </div>
                    </div>
                    
                    <div class="passenger-type">
                        <span class="passenger-label">Children</span>
                        <div class="passenger-counter">
                            <button class="counter-btn" onclick="updatePassengers('children', -1)">−</button>
                            <span class="counter-value" id="childrenCount">0</span>
                            <button class="counter-btn" onclick="updatePassengers('children', 1)">+</button>
                        </div>
                    </div>
                    
                    <div class="passenger-type">
                        <span class="passenger-label">Infants</span>
                        <div class="passenger-counter">
                            <button class="counter-btn" onclick="updatePassengers('infants', -1)">−</button>
                            <span class="counter-value" id="infantsCount">0</span>
                            <button class="counter-btn" onclick="updatePassengers('infants', 1)">+</button>
                        </div>
                    </div>
                    
                    <div class="class-select">
                        <select id="cabinClass" onchange="updateSummary()">
                            <option value="Economy">Economy</option>
                            <option value="Premium Economy">Premium Economy</option>
                            <option value="Business">Business</option>
                            <option value="First">First</option>
                        </select>
                    </div>
                </div>
            </div>
            
            <button class="search-button" onclick="searchFlights()">Search</button>
        </div>
    </div>

    <script>
        let passengers = {
            adults: 1,
            children: 0,
            infants: 0
        };

        // Set today's date as minimum for departure
        const today = new Date().toISOString().split('T')[0];
        document.getElementById('departDate').min = today;
        document.getElementById('returnDate').min = today;

        // Handle trip type changes
        document.getElementById('tripType').addEventListener('change', function() {
            const returnDateGroup = document.getElementById('returnDateGroup');
            if (this.value === 'round-trip') {
                returnDateGroup.style.display = 'block';
                // Set return date to one week after departure
                const departDate = new Date(document.getElementById('departDate').value);
                departDate.setDate(departDate.getDate() + 7);
                document.getElementById('returnDate').value = departDate.toISOString().split('T')[0];
            } else {
                returnDateGroup.style.display = 'none';
            }
        });

        // Update return date minimum when departure date changes
        document.getElementById('departDate').addEventListener('change', function() {
            document.getElementById('returnDate').min = this.value;
            if (document.getElementById('returnDate').value < this.value) {
                document.getElementById('returnDate').value = this.value;
            }
        });

        function swapLocations() {
            const fromInput = document.getElementById('fromInput');
            const toInput = document.getElementById('toInput');
            const temp = fromInput.value;
            fromInput.value = toInput.value;
            toInput.value = temp;
        }

        function togglePassengers() {
            const panel = document.getElementById('passengersPanel');
            panel.classList.toggle('active');
        }

        function updatePassengers(type, delta) {
            passengers[type] = Math.max(0, Math.min(9, passengers[type] + delta));
            
            // Ensure at least one adult
            if (type === 'adults' && passengers.adults === 0) {
                passengers.adults = 1;
            }
            
            // Update display
            document.getElementById(type + 'Count').textContent = passengers[type];
            
            // Update buttons state
            updateButtonStates();
            updateSummary();
        }

        function updateButtonStates() {
            // Disable minus button for adults if only 1
            const adultsMinusBtn = document.querySelector('.passenger-type:first-child .counter-btn:first-child');
            adultsMinusBtn.disabled = passengers.adults <= 1;
            
            // Disable minus buttons at 0
            const childrenMinusBtn = document.querySelector('.passenger-type:nth-child(2) .counter-btn:first-child');
            childrenMinusBtn.disabled = passengers.children <= 0;
            
            const infantsMinusBtn = document.querySelector('.passenger-type:nth-child(3) .counter-btn:first-child');
            infantsMinusBtn.disabled = passengers.infants <= 0;
            
            // Disable plus buttons at 9
            const allPlusBtns = document.querySelectorAll('.counter-btn:last-child');
            allPlusBtns[0].disabled = passengers.adults >= 9;
            allPlusBtns[1].disabled = passengers.children >= 9;
            allPlusBtns[2].disabled = passengers.infants >= 9;
        }

        function updateSummary() {
            const total = passengers.adults + passengers.children + passengers.infants;
            const cabinClass = document.getElementById('cabinClass').value;
            
            let summary = '';
            if (passengers.adults > 0) {
                summary += `${passengers.adults} Adult${passengers.adults > 1 ? 's' : ''}`;
            }
            if (passengers.children > 0) {
                summary += `, ${passengers.children} Child${passengers.children > 1 ? 'ren' : ''}`;
            }
            if (passengers.infants > 0) {
                summary += `, ${passengers.infants} Infant${passengers.infants > 1 ? 's' : ''}`;
            }
            
            summary += `, ${cabinClass}`;
            document.getElementById('passengersSummary').textContent = summary;
        }

        function searchFlights() {
            const from = document.getElementById('fromInput').value;
            const to = document.getElementById('toInput').value;
            const departDate = document.getElementById('departDate').value;
            const tripType = document.getElementById('tripType').value;
            const returnDate = tripType === 'round-trip' ? document.getElementById('returnDate').value : null;
            
            if (!from || !to || !departDate) {
                alert('Please fill in all required fields');
                return;
            }
            
            // Build search parameters
            const searchParams = {
                tripType,
                from,
                to,
                departDate,
                returnDate,
                passengers,
                cabinClass: document.getElementById('cabinClass').value
            };
            
            console.log('Searching flights with:', searchParams);
            alert(`Searching flights from ${from} to ${to} on ${departDate}`);
        }

        // Close passengers panel when clicking outside
        document.addEventListener('click', function(event) {
            const passengersDropdown = document.querySelector('.passengers-dropdown');
            if (!passengersDropdown.contains(event.target)) {
                document.getElementById('passengersPanel').classList.remove('active');
            }
        });

        // Add focus effects to input groups
        document.querySelectorAll('.input-field').forEach(input => {
            input.addEventListener('focus', function() {
                this.closest('.input-group').classList.add('focused');
            });
            
            input.addEventListener('blur', function() {
                this.closest('.input-group').classList.remove('focused');
            });
        });

        // Initialize button states
        updateButtonStates();
    </script>
</body>
</html> 